# Copy this file to .env and fill in your values:
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# Never commit .env to git. It is already listed in .gitignore.

# ---- Required for AI features --------------------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# ---- Optional: OpenAI ------------------------------------------------------
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2
# Leave empty if your model rejects custom temperatures.
OPENAI_TEMPERATURE=0.1

# ---- Optional: database ----------------------------------------------------
# Default (when unset) is a SQLite file at data/app.db.
# PostgreSQL example: postgresql+psycopg://user:password@host:5432/dbname
# DATABASE_URL=

# ---- Optional: pipeline rules ---------------------------------------------
MAX_QUERY_LENGTH=300
MAX_REWRITE_WORDS=25
DUPLICATE_WINDOW_SECONDS=300
CONTEXT_ACTIVITY_LIMIT=5

# ---- Optional: web ---------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=30
# Comma-separated origins, only needed if the UI is hosted on another domain.
CORS_ORIGINS=
